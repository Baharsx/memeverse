{
  "name": "memeverse",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "contracts:compile": "node scripts/compile-contracts.js",
    "contracts:test": "hardhat test nodejs",
    "markets:audit:onchain": "node scripts/audit-market-factory-onchain.js",
    "markets:verify": "npm run contracts:compile && node scripts/verify-market-factory.js",
    "deploy:mainnet:eoa": "npm run contracts:compile && node scripts/deploy-arc-mainnet-eoa.js",
    "assets:audit:onchain": "node scripts/audit-assets-onchain.js",
    "demo:preflight": "node scripts/demo-preflight.js",
    "rpc:burst:check": "node scripts/rpc-burst-check.js",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "start:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/test/*.test.js && npm run contracts:test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.90.21",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^12.23.26",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.45.2",
    "wagmi": "^3.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.2",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.5",
    "hardhat": "^3.12.0",
    "solc": "^0.8.30",
    "vite": "^7.3.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "qs": "6.16.0",
    "axios": "1.20.0",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.3",
    "adm-zip": "0.6.1",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici": "6.29.0"
  }
}
