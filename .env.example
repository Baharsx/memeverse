# Browser-safe values. Never put private keys or Circle credentials in VITE_* values.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.testnet.arc.io
VITE_API_BASE_URL=
# Stage 2 Arc contracts the browser reads directly. These are public onchain addresses, never
# secrets. Leaving one blank makes its surface render an explicit "not configured" state rather
# than falling back to demo data.
VITE_MEDIA_NFT_ADDRESS=0x56A6f87e4d026E6D9d3E3c791A3A30e023bf1CFD
VITE_NFT_MARKETPLACE_ADDRESS=0xfc3e869bA4Dd808A0942bc9C034f6f8427a08666
VITE_USDC_VAULT_ADDRESS=0xe26EeA49973226b406fd92Bd178484a29D7F7C05

# Backend-only configuration.
API_PORT=8787
# A bare origin: scheme://host[:port], with no trailing slash, path, query, or fragment.
# Production should serve the frontend and /api from this one origin behind a reverse proxy,
# because operator sessions use an HttpOnly, SameSite=Strict cookie.
APP_ORIGIN=http://127.0.0.1:5173
ARC_RPC_URL=https://rpc.testnet.arc.io
SETTLEMENT_DATA_FILE=.data/settlements.json
CIRCLE_NOTIFICATION_DATA_FILE=.data/circle-notifications.json
# DATABASE_URL=postgresql://user:password@host:5432/memeverse
# DATABASE_MIGRATION_URL=postgresql://migration-user:password@host:5432/memeverse
RUN_DATABASE_MIGRATIONS=true
PGLITE_DATA_DIR=.data/postgres
RECONCILIATION_INTERVAL_MS=5000
RECONCILIATION_LEASE_SECONDS=30
QUOTE_TTL_SECONDS=300
MAX_SPEND_USDC=25.00
MIN_VIRALITY_SCORE=78
CREATOR_SHARE_BPS=6000
AGENT_DAILY_SPEND_USDC=30.00
AGENT_MAX_FRAUD_RISK=20
AGENT_MIN_CONFIDENCE=80
AGENT_SIGNAL_MAX_AGE_SECONDS=300

# ── Autonomous creator settlement (Phase 6B.3) ─────────────────────────────────
# Autonomy is OFF here and the payout envelope is deliberately tiny. These committed values are
# production-safe defaults, not demo values: raise them only in uncommitted local configuration,
# and never weaken them to make a demonstration pass.
#
# Note that enabling this flag alone does not start paying anyone. The durable pause switch in
# PostgreSQL defaults to PAUSED and must be resumed by an authenticated operator, because an
# environment variable cannot serve as an emergency stop across multiple processes.
AGENT_AUTONOMOUS_ENABLED=false
# Confirmation depth for signal evidence. The collector's window always ends this far behind the
# chain head, and the anchor block hash is re-checked immediately before any payout.
AGENT_MIN_CONFIRMATIONS=12
AGENT_SIGNAL_LOOKBACK_BLOCKS=50000
# The bounded payout curve, in exact six-decimal USDC.
AGENT_AUTONOMOUS_MAX_PAYOUT_USDC=0.100000
AGENT_AUTONOMOUS_MIN_PAYOUT_USDC=0.010000
AGENT_MARKET_DAILY_CAP_USDC=0.300000
# Minimum confidence-adjusted score that earns any payout at all.
AGENT_AUTONOMOUS_SCORE_FLOOR=70
# One market may be paid at most once per cooldown window. The window is a deterministic epoch
# derived from chain time, so concurrent workers compute the same epoch and collide on one key.
AGENT_MARKET_COOLDOWN_SECONDS=3600
# How long a decision stays executable before its evidence is considered stale.
AGENT_DECISION_TTL_SECONDS=300
AGENT_WORKER_INTERVAL_MS=60000

# ── Stage 2 Arc contracts (Phase 6B.1 / 6B.2) ──────────────────────────────────
# Public onchain addresses. Safe to record here; they are not secrets.
# MEDIA_NFT_ADDRESS=
# NFT_MARKETPLACE_ADDRESS=
# USDC_VAULT_ADDRESS=
# Circle Smart Contract Platform identifiers. Operational, not secret, but deployment-specific.
# CIRCLE_MEDIA_NFT_CONTRACT_ID=
# CIRCLE_NFT_MARKETPLACE_CONTRACT_ID=
# CIRCLE_USDC_VAULT_CONTRACT_ID=
# A second real Arc identity, used only by the end-to-end scripts so an NFT sale has a genuine
# buyer and an autonomous payout has a creator who is not the paying treasury.
# CIRCLE_COUNTERPARTY_WALLET_ID=
# CIRCLE_COUNTERPARTY_ADDRESS=

# ── Circle Agent Stack: the autonomous executor (Phase 6B.3) ───────────────────
# Setting these two is what makes autonomous settlement exist at all. Without them the autonomous
# service is not constructed, the worker refuses to start, and the public agent route reports
# AGENT_NOT_CONFIGURED. There is deliberately no fallback to the manual Developer-Controlled
# Wallet: AUTONOMOUS_POLICY means the Agent Wallet paid, or nothing paid.
#
# These are SERVER-ONLY. Do not give them a VITE_ prefix: the browser has no business holding the
# autonomous executor's identity, and nothing in the UI needs it.
#
# The public Arc address of the Circle Agent Wallet created with `circle wallet create`. It is an
# ERC-4337 smart contract account, and it is the address reconciliation checks every autonomous
# SettlementExecuted event against.
# AGENT_WALLET_ADDRESS=
# The autonomous settlement contract whose *immutable operator* is that Agent Wallet. It must be a
# different contract from CIRCLE_SETTLEMENT_CONTRACT_ADDRESS, which belongs to the manual route.
# AGENT_SETTLEMENT_CONTRACT_ADDRESS=
# Circle Smart Contract Platform identifier for that deployment, if needed operationally.
# CIRCLE_AGENT_SETTLEMENT_CONTRACT_ID=
#
# The Circle CLI session itself is NOT configured here and must never be committed. It lives in
# the CLI's own machine-local state, is established by `circle wallet login <email>` with an
# emailed OTP, and expires. No login token, OTP, session credential, or account email belongs in
# this file or anywhere in Git.

# Privileged operator authentication. This is a SERVER-ONLY value and must never use a VITE_
# prefix. Set it to the checksummed EVM address of the wallet allowed to authorize Circle
# settlement execution; it is unrelated to ordinary MemeVerse market trading wallets.
# Production refuses to start with Circle execution credentials but no operator address.
# SETTLEMENT_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
OPERATOR_SESSION_TTL_SECONDS=1200
OPERATOR_CHALLENGE_TTL_SECONDS=300
OPERATOR_EXECUTION_TTL_SECONDS=180
# How long one caller owns a settlement's execution submission before another authorized
# operator may safely resume it with the same deterministic Circle idempotency identity.
EXECUTION_CLAIM_LEASE_SECONDS=120
# How often the process waiting on Circle renews that lease, so a slow provider call is not
# mistaken for a dead one. Must be less than half of EXECUTION_CLAIM_LEASE_SECONDS; an unsafe
# combination is rejected at startup. A process that dies simply stops renewing, and its lease
# then lapses on schedule.
EXECUTION_CLAIM_HEARTBEAT_SECONDS=30
# How often the supervised worker deletes long-expired operator challenges, sessions, and
# execution approvals.
AUTH_CLEANUP_INTERVAL_SECONDS=3600
# Number of trusted reverse-proxy hops. Leave at 0 unless a proxy you control sets
# X-Forwarded-For; never enable blanket proxy trust.
TRUSTED_PROXY_HOP_COUNT=0

# Circle Developer-Controlled Wallets. Keep real values in .env.local only.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# CIRCLE_WALLET_ID=
# CIRCLE_SETTLEMENT_CONTRACT_ID=
# CIRCLE_SETTLEMENT_DEPLOYMENT_TX_ID=
# CIRCLE_SETTLEMENT_CONTRACT_ADDRESS=
# CIRCLE_SETTLEMENT_APPROVAL_TX_ID=
# CIRCLE_MARKET_FACTORY_CONTRACT_ID=
# CIRCLE_MARKET_FACTORY_DEPLOYMENT_TX_ID=
MARKET_FACTORY_ADDRESS=0x363124490E953EEbB414eB4c3e2f03a40eef8F2C
# Server-only; expected format: KIT_KEY:<id>:<secret>
# CIRCLE_KIT_KEY=
CIRCLE_SETTLEMENT_ALLOWANCE_USDC=20.00
CIRCLE_API_BASE_URL=https://api.circle.com
CIRCLE_FEE_LEVEL=MEDIUM
CIRCLE_WEBHOOK_KEY_CACHE_SECONDS=3600
# Required only when creating a Circle webhook subscription.
# CIRCLE_WEBHOOK_URL=https://your-api.example/api/webhooks/circle
