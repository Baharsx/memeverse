# Development / testnet example. Never commit real private keys.
# Mainnet deploys require verified chain 5042 and the confirmed factory address.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=8787
ARC_NETWORK=testnet
VITE_ARC_NETWORK=testnet
VITE_ARC_CHAIN_ID=5042002

# Application RPC endpoints (reads) and canonical wallet RPC registration.
ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.testnet.arc.io
VITE_ARC_WALLET_RPC_URL=https://rpc.testnet.arc.network
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Public browser configuration only. Use VITE_BASE_PATH=/ for root-domain hosting.
VITE_BASE_PATH=/memeverse/
VITE_API_BASE_URL=
# Create a public project ID at https://dashboard.reown.com and configure the
# allowed origin https://memeverse.biz. Disable email/social login, swaps and on-ramp.
VITE_REOWN_PROJECT_ID=
VITE_MARKET_FACTORY_ADDRESS=0x363124490E953EEbB414eB4c3e2f03a40eef8F2C
VITE_MEMEVERSE_FACTORY_ADDRESS=
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Writable server storage for image uploads AND wallet-signed referrals.
# Referral files are written under MEDIA_STORAGE_DIR/referrals/.
MEDIA_STORAGE_DIR=.data/media
TRUSTED_PROXY_HOP_COUNT=0

# Manual mainnet deployment script only. Not used by the web API.
DEPLOYER_PRIVATE_KEY=

# Mainnet production values (example, never copy testnet factory):
# NODE_ENV=production
# APP_ORIGIN=https://memeverse.biz
# ARC_NETWORK=mainnet
# VITE_ARC_NETWORK=mainnet
# VITE_ARC_CHAIN_ID=5042
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.mainnet.arc.io
# VITE_ARC_WALLET_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_EXPLORER_URL=https://explorer.arc.io
# VITE_BASE_PATH=/
# VITE_MEMEVERSE_FACTORY_ADDRESS=0x177492EFFbe5F7847994696ef4C9B24b8C9C13BE
# MEDIA_STORAGE_DIR=/var/lib/memeverse/media
# TRUSTED_PROXY_HOP_COUNT=1
