# Browser-safe values. Never put private keys or Circle credentials in VITE_* values.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_API_BASE_URL=

# Backend-only configuration.
API_PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
ARC_RPC_URL=https://rpc.testnet.arc.io
SETTLEMENT_DATA_FILE=.data/settlements.json
CIRCLE_NOTIFICATION_DATA_FILE=.data/circle-notifications.json
# DATABASE_URL=postgresql://user:password@host:5432/memeverse
PGLITE_DATA_DIR=.data/postgres
RECONCILIATION_INTERVAL_MS=5000
QUOTE_TTL_SECONDS=300
MAX_SPEND_USDC=25.00
MIN_VIRALITY_SCORE=78
CREATOR_SHARE_BPS=6000

# Circle Developer-Controlled Wallets. Keep real values in .env.local only.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# CIRCLE_WALLET_ID=
# CIRCLE_SETTLEMENT_CONTRACT_ID=
# CIRCLE_SETTLEMENT_DEPLOYMENT_TX_ID=
# CIRCLE_SETTLEMENT_CONTRACT_ADDRESS=
# CIRCLE_SETTLEMENT_APPROVAL_TX_ID=
CIRCLE_SETTLEMENT_ALLOWANCE_USDC=20.00
CIRCLE_API_BASE_URL=https://api.circle.com
CIRCLE_FEE_LEVEL=MEDIUM
CIRCLE_WEBHOOK_KEY_CACHE_SECONDS=3600
# Required only when creating a Circle webhook subscription.
# CIRCLE_WEBHOOK_URL=https://your-api.example/api/webhooks/circle
