NODE_ENV=production
API_PORT=8787
# A bare origin only. Serve the static frontend and /api from this same origin through the
# reverse proxy; operator session cookies are HttpOnly and SameSite=Strict.
APP_ORIGIN=https://example.invalid
# Default remains testnet until docs/MAINNET.md Gate 4. After cutover set both to mainnet.
ARC_NETWORK=testnet
VITE_ARC_NETWORK=testnet
VITE_ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.testnet.arc.io
VITE_ARC_WALLET_RPC_URL=https://rpc.testnet.arc.network
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app
# Mainnet (paste only after contracts exist on 5042 — never reuse the testnet factory):
# ARC_NETWORK=mainnet
# VITE_ARC_NETWORK=mainnet
# VITE_ARC_CHAIN_ID=5042
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.mainnet.arc.io
# VITE_ARC_WALLET_RPC_URL=https://rpc.mainnet.arc.io
# VITE_ARC_EXPLORER_URL=https://explorer.arc.io
# VITE_MEMEVERSE_FACTORY_ADDRESS=
# VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Circle is not used on Arc mainnet. Leave CIRCLE_* testnet keys unused. Do not point them at 5042.
# AGENT_AUTONOMOUS_ENABLED stays false. Autonomous rewards are not live on mainnet.
# DEPLOYER_PRIVATE_KEY is server-only. Never commit it and never put it in a VITE_* variable.
DATABASE_URL=postgresql://memeverse:replace-me@postgres.example.invalid:5432/memeverse?sslmode=require
# DATABASE_MIGRATION_URL belongs only in the one-shot migration environment.
RECONCILIATION_INTERVAL_MS=5000
RECONCILIATION_LEASE_SECONDS=30

# Creator media. The API writes content-addressed image files and one small pointer document per
# market here. It holds no secrets, so it needs no special protection beyond ordinary ownership —
# but the API unit's ProtectSystem=strict means this exact path must appear in its ReadWritePaths.
# The worker neither reads nor writes it.
MEDIA_STORAGE_DIR=/var/lib/memeverse/media

# Required whenever Circle settlement execution credentials are present.
SETTLEMENT_OPERATOR_ADDRESS=replace-me
OPERATOR_SESSION_TTL_SECONDS=1200
OPERATOR_CHALLENGE_TTL_SECONDS=300
OPERATOR_EXECUTION_TTL_SECONDS=180
EXECUTION_CLAIM_LEASE_SECONDS=120
# Must be less than half of EXECUTION_CLAIM_LEASE_SECONDS, or the process refuses to start.
EXECUTION_CLAIM_HEARTBEAT_SECONDS=30
AUTH_CLEANUP_INTERVAL_SECONDS=3600
# Set to the number of reverse-proxy hops in front of the API, or leave at 0.
TRUSTED_PROXY_HOP_COUNT=1

# Load these from the production secret manager, never from Git. Empty in this example on purpose.
# Testnet prefix TEST_API_KEY:  — mainnet prefix LIVE_API_KEY:
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_SETTLEMENT_CONTRACT_ADDRESS=

# ── Settlement policy ────────────────────────────────────────────────────────
# Split of a gross settlement request. The creator receives this share; the remainder is simply
# not transferred. Autonomous caps below are expressed in what the creator actually receives.
CREATOR_SHARE_BPS=6000
MAX_SPEND_USDC=25.00
MIN_VIRALITY_SCORE=78
AGENT_DAILY_SPEND_USDC=30.00
AGENT_MAX_FRAUD_RISK=20
AGENT_MIN_CONFIDENCE=80
AGENT_SIGNAL_MAX_AGE_SECONDS=300

# ── Autonomous agent ─────────────────────────────────────────────────────────
# FAIL-CLOSED BY DESIGN. Autonomy stays off until a deployment has proved, on the host and as the
# service user, that the Agent Wallet can actually sign. Turning this on is a deliberate act.
AGENT_AUTONOMOUS_ENABLED=false
# Confirmation depth before Arc trading evidence is trusted, and how far back the collector scans.
AGENT_MIN_CONFIRMATIONS=12
AGENT_SIGNAL_LOOKBACK_BLOCKS=50000
# Spend envelope, in USDC the creator receives. Deliberately small.
AGENT_AUTONOMOUS_MAX_PAYOUT_USDC=0.100000
AGENT_AUTONOMOUS_MIN_PAYOUT_USDC=0.010000
AGENT_MARKET_DAILY_CAP_USDC=0.300000
AGENT_AUTONOMOUS_SCORE_FLOOR=70
AGENT_MARKET_COOLDOWN_SECONDS=3600
AGENT_DECISION_TTL_SECONDS=300
AGENT_WORKER_INTERVAL_MS=60000

# ── Public Arc addresses ─────────────────────────────────────────────────────
# Deployed and readable by anyone on the explorer. These are not secrets.
# TESTNET factory only. Mainnet must not reuse 0x3631… .
MARKET_FACTORY_ADDRESS=0x363124490E953EEbB414eB4c3e2f03a40eef8F2C
VITE_MARKET_FACTORY_ADDRESS=0x363124490E953EEbB414eB4c3e2f03a40eef8F2C
VITE_MEDIA_NFT_ADDRESS=0x56A6f87e4d026E6D9d3E3c791A3A30e023bf1CFD
VITE_NFT_MARKETPLACE_ADDRESS=0xfc3e869bA4Dd808A0942bc9C034f6f8427a08666
VITE_USDC_VAULT_ADDRESS=0xe26EeA49973226b406fd92Bd178484a29D7F7C05
# The Circle Agent Wallet (ERC-4337 smart account) and the settlement contract whose immutable
# operator it is. Reconciliation takes the expected operator from this configuration rather than
# from the event it is verifying, so a wrong value fails closed instead of trusting the chain.
AGENT_WALLET_ADDRESS=0x65da73c6d9300F3dAb1dF785219f76DeCA5e0FE3
AGENT_SETTLEMENT_CONTRACT_ADDRESS=0x2176107C2562Ed30ca1d490C43cD53C3369946e2
# Optional: only needed by the Circle-side deployment tooling, not by the runtime payout path.
# CIRCLE_AGENT_SETTLEMENT_CONTRACT_ID=replace-me

# ── Optional Circle surfaces ─────────────────────────────────────────────────
# Stablecoin Kits swap estimates on /quote. Server-only; omit to leave the surface disabled.
# CIRCLE_KIT_KEY=replace-me
# Signed settlement notifications. Omit to leave the webhook route disabled.
# CIRCLE_WEBHOOK_URL=https://example.invalid/api/webhooks/circle
CIRCLE_WEBHOOK_KEY_CACHE_SECONDS=3600

# ── Deployment notes for the autonomous worker ───────────────────────────────
# Autonomous execution shells out to Circle's official `circle` CLI. That has consequences a
# deployment has to confirm rather than assume:
#
#   * The `circle` binary must be installed on the host and on PATH for the worker process.
#   * Agent Wallet TESTNET authentication is machine- and user-context specific. It is not a
#     value you can place in this file.
#   * Both units run as the systemd user `memeverse`. An administrator's own Circle session,
#     established over SSH as a different user, is NOT visible to the service.
#   * Before setting AGENT_AUTONOMOUS_ENABLED=true, prove from the service-user context — not
#     from an interactive admin shell — that `circle wallet status` reports a VALID testnet
#     session and that an Agent Wallet balance/readiness read succeeds. `npm run demo:preflight`
#     and the /agent surface both report this: the agent reads ACTIVE only when the wallet is
#     configured and LIVE.
#   * If the CLI cannot reach its session under the sandbox, do NOT relax the systemd hardening
#     to make it work. Establish first what access it actually requires, then make the smallest
#     change that grants exactly that. Loosening ProtectHome or ProtectSystem speculatively
#     trades a real security boundary for a guess.
