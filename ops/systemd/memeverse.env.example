# Minimal production API / Vite deployment example.
NODE_ENV=production
API_PORT=8787
APP_ORIGIN=https://memeverse.biz
ARC_NETWORK=mainnet
VITE_ARC_NETWORK=mainnet
VITE_ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_FALLBACK_RPC_URL=https://rpc.drpc.mainnet.arc.io
VITE_ARC_WALLET_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_EXPLORER_URL=https://explorer.arc.io
VITE_BASE_PATH=/
VITE_API_BASE_URL=
VITE_MEMEVERSE_FACTORY_ADDRESS=0x177492EFFbe5F7847994696ef4C9B24b8C9C13BE
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Set the public Reown project ID in the deployment environment.
VITE_REOWN_PROJECT_ID=

# Same writable path already granted by memeverse-api.service.
# Referral attribution lives under /var/lib/memeverse/media/referrals.
MEDIA_STORAGE_DIR=/var/lib/memeverse/media
TRUSTED_PROXY_HOP_COUNT=1

# If a server retains obsolete environment variables, the current API ignores
# them. Do not put payment authorization secrets in this file.
