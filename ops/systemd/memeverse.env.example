NODE_ENV=production
API_PORT=8787
APP_ORIGIN=https://example.invalid
ARC_RPC_URL=https://rpc.testnet.arc.io
DATABASE_URL=postgresql://memeverse:replace-me@postgres.example.invalid:5432/memeverse?sslmode=require
# DATABASE_MIGRATION_URL belongs only in the one-shot migration environment.
RECONCILIATION_INTERVAL_MS=5000
RECONCILIATION_LEASE_SECONDS=30

# Required whenever Circle settlement execution credentials are present.
SETTLEMENT_OPERATOR_ADDRESS=replace-me
OPERATOR_SESSION_TTL_SECONDS=1200
OPERATOR_CHALLENGE_TTL_SECONDS=300
OPERATOR_EXECUTION_TTL_SECONDS=180
# Set to the number of reverse-proxy hops in front of the API, or leave at 0.
TRUSTED_PROXY_HOP_COUNT=1

# Load these from the production secret manager, never from Git.
CIRCLE_API_KEY=replace-me
CIRCLE_ENTITY_SECRET=replace-me
CIRCLE_WALLET_ID=replace-me
CIRCLE_SETTLEMENT_CONTRACT_ADDRESS=replace-me
